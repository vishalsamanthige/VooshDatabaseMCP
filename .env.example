# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# Tuning (all optional — defaults shown)
# ─────────────────────────────────────────────────────────────
# Per-request timeout to a child DB process, in ms (default 120000 = 2 min).
MCP_REQUEST_TIMEOUT_MS=120000
# Browser origins allowed to call /mcp, comma-separated (default none). Requests
# without an Origin header are always allowed.
MCP_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────
# DB1 — SECONDARY database
# (used only for restaurant_details + extraction-log tables)
# Its MYSQL_DB value is also the tool-name prefix, e.g. `<db>_mysql_query`.
# ─────────────────────────────────────────────────────────────
DB1_MYSQL_HOST=
DB1_MYSQL_PORT=3306
DB1_MYSQL_USER=
DB1_MYSQL_PASS=
DB1_MYSQL_DB=
DB1_MYSQL_SSL=true
DB1_ALLOW_INSERT=false
DB1_ALLOW_UPDATE=false
DB1_ALLOW_DELETE=false

# ─────────────────────────────────────────────────────────────
# DB2 — PRIMARY database (queried first)
# Its MYSQL_DB value is also the tool-name prefix.
# ─────────────────────────────────────────────────────────────
DB2_MYSQL_HOST=
DB2_MYSQL_PORT=true
DB2_MYSQL_USER=
DB2_MYSQL_PASS=
DB2_MYSQL_DB=
DB2_MYSQL_SSL=false
DB2_ALLOW_INSERT=false
DB2_ALLOW_UPDATE=false
DB2_ALLOW_DELETE=false
